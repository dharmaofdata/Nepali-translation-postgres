#: help.c:60
msgid ""
"psql is the PostgreSQL interactive terminal.\n"
"\n"
msgstr ""

#: help.c:61 help.c:384 help.c:471 help.c:524
msgid "Usage:\n"
msgstr ""

#: help.c:62
msgid ""
"  psql [OPTION]... [DBNAME [USERNAME]]\n"
"\n"
msgstr ""

#: help.c:64
msgid "General options:\n"
msgstr ""

#: help.c:65
msgid "  -c, --command=COMMAND    run only single command (SQL or internal) and exit\n"
msgstr ""

#: help.c:66
msgid "  -d, --dbname=DBNAME      database name to connect to\n"
msgstr ""

#: help.c:67
msgid "  -f, --file=FILENAME      execute commands from file, then exit\n"
msgstr ""

#: help.c:68
msgid "  -l, --list               list available databases, then exit\n"
msgstr ""

#: help.c:69
msgid ""
"  -v, --set=, --variable=NAME=VALUE\n"
"                           set psql variable NAME to VALUE\n"
"                           (e.g., -v ON_ERROR_STOP=1)\n"
msgstr ""

#: help.c:72
msgid "  -V, --version            output version information, then exit\n"
msgstr ""

#: help.c:73
msgid "  -X, --no-psqlrc          do not read startup file (~/.psqlrc)\n"
msgstr ""

#: help.c:74
msgid ""
"  -1 (\"one\"), --single-transaction\n"
"                           execute as a single transaction (if non-interactive)\n"
msgstr ""

#: help.c:76
msgid "  -?, --help[=options]     show this help, then exit\n"
msgstr ""

#: help.c:77
msgid "      --help=commands      list backslash commands, then exit\n"
msgstr ""

#: help.c:78
msgid "      --help=variables     list special variables, then exit\n"
msgstr ""

#: help.c:80
msgid ""
"\n"
"Input and output options:\n"
msgstr ""

#: help.c:81
msgid "  -a, --echo-all           echo all input from script\n"
msgstr ""

#: help.c:82
msgid "  -b, --echo-errors        echo failed commands\n"
msgstr ""

#: help.c:83
msgid "  -e, --echo-queries       echo commands sent to server\n"
msgstr ""

#: help.c:84
msgid "  -E, --echo-hidden        display queries that internal commands generate\n"
msgstr ""

#: help.c:85
msgid "  -L, --log-file=FILENAME  send session log to file\n"
msgstr ""

#: help.c:86
msgid "  -n, --no-readline        disable enhanced command line editing (readline)\n"
msgstr ""

#: help.c:87
msgid "  -o, --output=FILENAME    send query results to file (or |pipe)\n"
msgstr ""

#: help.c:88
msgid "  -q, --quiet              run quietly (no messages, only query output)\n"
msgstr ""

#: help.c:89
msgid "  -s, --single-step        single-step mode (confirm each query)\n"
msgstr ""

#: help.c:90
msgid "  -S, --single-line        single-line mode (end of line terminates SQL command)\n"
msgstr ""

#: help.c:92
msgid ""
"\n"
"Output format options:\n"
msgstr ""

#: help.c:93
msgid "  -A, --no-align           unaligned table output mode\n"
msgstr ""

#: help.c:94
msgid "      --csv                CSV (Comma-Separated Values) table output mode\n"
msgstr ""

#: help.c:95
#, c-format
msgid ""
"  -F, --field-separator=STRING\n"
"                           field separator for unaligned output (default: \"%s\")\n"
msgstr ""

#: help.c:98
msgid "  -H, --html               HTML table output mode\n"
msgstr ""

#: help.c:99
msgid "  -P, --pset=VAR[=ARG]     set printing option VAR to ARG (see \\pset command)\n"
msgstr ""

#: help.c:100
msgid ""
"  -R, --record-separator=STRING\n"
"                           record separator for unaligned output (default: newline)\n"
msgstr ""

#: help.c:102
msgid "  -t, --tuples-only        print rows only\n"
msgstr ""

#: help.c:103
msgid "  -T, --table-attr=TEXT    set HTML table tag attributes (e.g., width, border)\n"
msgstr ""

#: help.c:104
msgid "  -x, --expanded           turn on expanded table output\n"
msgstr ""

#: help.c:105
msgid ""
"  -z, --field-separator-zero\n"
"                           set field separator for unaligned output to zero byte\n"
msgstr ""

#: help.c:107
msgid ""
"  -0, --record-separator-zero\n"
"                           set record separator for unaligned output to zero byte\n"
msgstr ""

#: help.c:110
msgid ""
"\n"
"Connection options:\n"
msgstr ""

#: help.c:111
msgid "  -h, --host=HOSTNAME      database server host or socket directory\n"
msgstr ""

#: help.c:112
msgid "  -p, --port=PORT          database server port\n"
msgstr ""

#: help.c:113
msgid "  -U, --username=USERNAME  database user name\n"
msgstr ""

#: help.c:114
msgid "  -w, --no-password        never prompt for password\n"
msgstr ""

#: help.c:115
msgid "  -W, --password           force password prompt (should happen automatically)\n"
msgstr ""

#: help.c:117
msgid ""
"\n"
"For more information, type \"\\?\" (for internal commands) or \"\\help\" (for SQL\n"
"commands) from within psql, or consult the psql section in the PostgreSQL\n"
"documentation.\n"
"\n"
msgstr ""

#: help.c:120
#, c-format
msgid "Report bugs to <%s>.\n"
msgstr ""

#: help.c:121
#, c-format
msgid "%s home page: <%s>\n"
msgstr ""

#: help.c:163
msgid "General\n"
msgstr ""

#: help.c:164
msgid "  \\copyright             show PostgreSQL usage and distribution terms\n"
msgstr ""

#: help.c:165
msgid "  \\crosstabview [COLUMNS] execute query and display result in crosstab\n"
msgstr ""

#: help.c:166
msgid "  \\errverbose            show most recent error message at maximum verbosity\n"
msgstr ""

#: help.c:167
msgid ""
"  \\g [(OPTIONS)] [FILE]  execute query (and send result to file or |pipe);\n"
"                         \\g with no arguments is equivalent to a semicolon\n"
msgstr ""

#: help.c:169
msgid "  \\gdesc                 describe result of query, without executing it\n"
msgstr ""

#: help.c:170
msgid "  \\gexec                 execute query, then execute each value in its result\n"
msgstr ""

#: help.c:171
msgid "  \\gset [PREFIX]         execute query and store result in psql variables\n"
msgstr ""

#: help.c:172
msgid "  \\gx [(OPTIONS)] [FILE] as \\g, but forces expanded output mode\n"
msgstr ""

#: help.c:173
msgid "  \\q                     quit psql\n"
msgstr ""

#: help.c:174
msgid ""
"  \\restrict RESTRICT_KEY\n"
"                         enter restricted mode with provided key\n"
msgstr ""

#: help.c:176
msgid ""
"  \\unrestrict RESTRICT_KEY\n"
"                         exit restricted mode if key matches\n"
msgstr ""

#: help.c:178
msgid ""
"  \\watch [[i=]SEC] [c=N] [m=MIN]\n"
"                         execute query every SEC seconds, up to N times,\n"
"                         stop if less than MIN rows are returned\n"
msgstr ""

